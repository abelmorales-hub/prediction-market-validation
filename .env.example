# Copy to .env before running anything. No defaults are baked into the code.

GAMMA_BASE_URL=https://gamma-api.polymarket.com
CLOB_BASE_URL=https://clob.polymarket.com

# Cheap read-only paths used by the pre-flight reachability check.
GAMMA_PREFLIGHT_PATH=/markets?limit=1
CLOB_PREFLIGHT_PATH=/ok

HTTP_TIMEOUT_S=10.0
DATA_DIR=data

# Supabase (unused until M2). Read/write of the small relational state only.
# SUPABASE_DB_URL=postgresql://postgres:...@db.<project>.supabase.co:5432/postgres
