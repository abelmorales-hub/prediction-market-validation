# Copy to .env before running anything. No defaults are baked into the code.

# Kalshi trade-api v2. The old trading-api.kalshi.com host now returns 401 with a
# migration notice, so this URL is the live one, verified by pre-flight.
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# Optional JSON list override for the pre-flight paths.
# PREFLIGHT_PATHS=["/exchange/status", "/markets?limit=1"]

HTTP_TIMEOUT_S=10.0
DATA_DIR=data

# Postgres for the small relational state only (catalogue, predictions, outcomes,
# features). Book snapshots never go here. Unset means the DB tests skip.
# SUPABASE_DB_URL=postgresql://postgres:...@db.<project>.supabase.co:5432/postgres
